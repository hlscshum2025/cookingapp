# Supabase Dashboard > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Older Supabase projects may expose an anon public key instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Cloudflare Turnstile public site key. This value is intentionally exposed to
# the browser. Configure the matching secret only in Supabase Auth > Bot and
# Abuse Protection > CAPTCHA; never store it in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Long-running Python OCR worker. Do not point this at a Supabase Edge Function.
NEXT_PUBLIC_VISION_API_URL=http://localhost:8000

# OCR worker only (server-side environment, never NEXT_PUBLIC_)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# VISION_ALLOWED_ORIGINS=http://localhost:3000,https://YOUR_SITE.example
# VISION_DEV_ALLOW_UNAUTHENTICATED=1
