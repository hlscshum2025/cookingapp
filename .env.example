# Supabase Dashboard > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Older Supabase projects may expose an anon public key instead.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Cloudflare Turnstile public site key. This key is safe to expose in the browser.
# The matching SECRET key must NEVER be stored here or in any NEXT_PUBLIC_ variable.
# Configure the secret only in Supabase Auth > Bot and Abuse Protection > CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
